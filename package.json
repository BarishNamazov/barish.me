    "astro": "^5.16.4",
    "remark-toc": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.33.0",
    "eslint-plugin-astro": "^1.3.1",
    "glyphhanger": "^5.0.0",
    "http-server": "^14.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.5.2"
