---
const today = new Date();

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<footer class={className} id="site-footer">
  <span>
    © {today.getFullYear()} Abutalib (Barish) Namazov. <a
      href="https://github.com/BarishNamazov/barish.me"
      target="_blank"
      rel="noopener noreferrer">This site is open-source.</a
    >
  </span>
  <span class="social">
    <a href="/rss.xml">
      <img src="/icons/rss.svg" alt="RSS" />
    </a>
    <a
      href="https://github.com/BarishNamazov"
      target="_blank"
      rel="noopener noreferrer me"
    >
      <img src="/icons/github-mark.svg" alt="GitHub" />
    </a>
    <a
      href="https://www.linkedin.com/in/abutalib-namazov/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img src="/icons/linkedin.svg" alt="LinkedIn" />
    </a>
  </span>
</footer>

<style>
  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--padding-medium);

    & .social {
      display: flex;
      align-items: center;
      gap: var(--gap-medium);

      & a {
        text-decoration: none;
        display: flex;
        align-items: center;

        &::after {
          all: unset;
        }
      }

      & img {
        max-width: none;
        width: var(--icon-size-medium);
        border-radius: 0;
      }
    }
  }

  @media print {
    footer {
      background: none !important;
      justify-content: center;
    }

    .social {
      display: none !important;
    }
  }
</style>
