---
import { getCollection } from "astro:content";
import type { ContentTypeKey } from "../content-types";
import { getContentTypeConfig } from "../content-types";
import { sortContentByDate } from "../utils/contentSorting";
import Layout from "../layouts/Layout.astro";
import PostList from "./PostList.astro";

interface Props {
  contentType: ContentTypeKey;
}

const { contentType } = Astro.props;
const config = getContentTypeConfig(contentType);
const posts = sortContentByDate(await getCollection(contentType));
---

<Layout titlePrefix={config.titlePrefix}>
  <h1>{config.title}</h1>
  <p>{config.description}</p>
  <section>
    <PostList posts={posts} sublink={contentType} />
  </section>
</Layout>
