---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  posts: CollectionEntry<"blog">[] | CollectionEntry<"lessons">[];
  sublink: string;
}

const { posts, sublink } = Astro.props;
---

<style>
  li.star::after {
    content: " ⭐️";
  }
</style>

<ul>
  {
    posts.map(post => (
      <li class={post.data.star ? "star" : ""}>
        <a href={`/${sublink}/${post.slug}`}>{post.data.title}</a> -{" "}
        <FormattedDate date={post.data.date} />
      </li>
    ))
  }
</ul>
