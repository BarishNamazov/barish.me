---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  posts: CollectionEntry<"blog">[] | CollectionEntry<"lessons">[];
  sublink: string;
}

const { posts, sublink } = Astro.props;
---

<style>
  ul {
    list-style: none;
    padding: 0;
    max-width: fit-content;
    margin: 0 auto;
  }

  li {
    margin-bottom: 0.5rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .date {
    width: 8rem;
    flex-shrink: 0;
    font-family: "JetBrains Mono", monospace;
  }

  .title {
    flex: 1;
  }
</style>

<ul>
  {
    posts.map(post => (
      <li>
        <span class="date">
          <FormattedDate date={post.data.date} />
        </span>
        <span class="title">
          <a href={`/${sublink}/${post.slug}`}>{post.data.title}</a>
        </span>
      </li>
    ))
  }
</ul>
