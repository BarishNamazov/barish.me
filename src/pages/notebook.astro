---
import Layout from "../layouts/Layout.astro";

const notebookFiles = Object.values(import.meta.glob("./notebook/*.md", { eager: true }));
const notebookEntries = notebookFiles.map((file: any) => ({
  title: file.frontmatter.title,
  href: file.url,
  description: file.frontmatter.description,
  updatedDate: file.frontmatter.updatedDate,
  type: "notebook-entry" as const,
})).sort((a, b) => {
  return a.title.localeCompare(b.title);
});

const manualEntries = [
  {
    title: "Computing",
    href: "/computing",
    description: "My hardware and software setup.",
    type: "external-entry" as const,
  },
  {
    title: "Resume",
    href: "/resume",
    description: "Brief overview of my education and work history.",
    type: "external-entry" as const,
  },
];

const allEntries = [...notebookEntries, ...manualEntries];
---

<Layout titlePrefix="Notebook">
  <h1>Notebook</h1>
  <p>I collect various pages and entries in this notebook.</p>

  <section class="lists-container">
    <ul>
      {
        allEntries.map(item => (
          <li>
            <article class="list-item">
              <div class="list-header">
                <h3 class="list-title">
                  <a href={item.href}>{item.title}</a>
                </h3>
                <span class={`badge ${item.type}`}>{item.type}</span>
              </div>
              {item.description && (
                <p class="list-description">{item.description}</p>
              )}
            </article>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .lists-container {
    display: flex;
    flex-direction: column;
    gap: var(--gap-medium);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-medium);
  }

  li {
    margin: 0;
  }

  .list-item {
    display: flex;
    flex-direction: column;
    gap: var(--gap-small);
    padding-bottom: var(--gap-medium);
    border-bottom: 1px solid color-mix(in srgb, var(--black) 10%, transparent);
  }

  .list-header {
    display: flex;
    align-items: center;
    gap: var(--gap-small);
  }

  .list-title {
    margin: 0;
    font-size: var(--font-size-h4);
  }

  .badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-weight: 500;
    white-space: nowrap;
  }

  .badge.notebook-entry {
    background-color: color-mix(in srgb, var(--accent) 20%, transparent);
    color: var(--accent);
  }

  .badge.external-entry {
    background-color: color-mix(in srgb, var(--black) 15%, transparent);
    color: var(--text-color-muted);
  }

  .list-title a {
    color: inherit;
    text-decoration: none;
  }

  .list-title a:hover,
  .list-title a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--accent);
  }

  .list-description {
    margin: 0;
    color: var(--text-color-muted);
  }
</style>
