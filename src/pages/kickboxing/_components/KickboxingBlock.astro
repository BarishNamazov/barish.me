---
interface Props {
  kind: "warm-up" | "stretch" | "technique" | "drill" | "cardio" | "cool-down";
  label: string;
  timer?: string | number;
  beeps?: string | number;
}

const { kind, label, timer, beeps } = Astro.props;

const parseTimer = (value: Props["timer"]) => {
  if (value === undefined || value === null || value === "") return undefined;

  const raw = String(value).trim().toLowerCase();
  const colonParts = raw.split(":");

  if (colonParts.length > 1) {
    const parts = colonParts.map(part => Number(part));
    if (parts.some(part => !Number.isFinite(part) || part < 0))
      return undefined;

    return parts.reduce((total, part) => total * 60 + part, 0);
  }

  const minuteMatch = raw.match(/^(\d+(?:\.\d+)?)\s*m(?:in(?:ute)?s?)?$/);
  if (minuteMatch) return Math.round(Number(minuteMatch[1]) * 60);

  const secondMatch = raw.match(/^(\d+(?:\.\d+)?)\s*s(?:ec(?:ond)?s?)?$/);
  if (secondMatch) return Math.round(Number(secondMatch[1]));

  const number = Number(raw);
  if (Number.isFinite(number) && number > 0) return Math.round(number * 60);

  return undefined;
};

const formatDuration = (seconds: number) => {
  const minutes = Math.floor(seconds / 60);
  const remainingSeconds = seconds % 60;

  return `${minutes}:${String(remainingSeconds).padStart(2, "0")}`;
};

const duration = parseTimer(timer);

// `beeps` is an interval in the same format as `timer`: sound a cue every
// <interval> of elapsed time (e.g. "30s" → a beep every 30 seconds). The
// marks below are the clock readings (seconds remaining) at each interval.
// Empty = no middle beeps; the start and end tones are unaffected.
const beepInterval = parseTimer(beeps);
const beepMarks: number[] = [];
if (beepInterval && duration) {
  for (let elapsed = beepInterval; elapsed < duration; elapsed += beepInterval) {
    beepMarks.push(duration - elapsed);
  }
}

const timerLabel = duration ? formatDuration(duration) : undefined;
---

<section class:list={["kickboxing-block", `kickboxing-block--${kind}`]}>
  <header class="kickboxing-block__header">
    <div class="kickboxing-block__label-wrap">
      <span class="kickboxing-block__mark" aria-hidden="true"></span>
      <h3 class="kickboxing-block__label">{label}</h3>
    </div>

    {
      duration && (
        <div
          class="kickboxing-timer"
          data-kickboxing-timer
          data-duration={duration}
          data-beeps={beepMarks.length ? beepMarks.join(",") : undefined}
          style={`--timer-progress: 0;`}
        >
          <div class="kickboxing-timer__readout" aria-live="polite">
            {timerLabel}
          </div>
          <div class="kickboxing-timer__bar" aria-hidden="true">
            <span />
          </div>
          <div class="kickboxing-timer__controls">
            <button
              class="kickboxing-timer__button kickboxing-timer__button--start"
              type="button"
              data-timer-toggle
              aria-label={`Start ${label} timer`}
            >
              Start
            </button>
            <button
              class="kickboxing-timer__button kickboxing-timer__button--reset"
              type="button"
              data-timer-reset
              aria-label={`Reset ${label} timer`}
            >
              Reset
            </button>
          </div>
        </div>
      )
    }
  </header>

  <div class="kickboxing-block__body">
    <slot />
  </div>
</section>

<script>
  const formatTime = (seconds: number) => {
    const safeSeconds = Math.max(0, Math.ceil(seconds));
    const minutes = Math.floor(safeSeconds / 60);
    const remainingSeconds = safeSeconds % 60;

    return `${minutes}:${String(remainingSeconds).padStart(2, "0")}`;
  };

  let audioContext: AudioContext | undefined;

  const getAudioContext = () => {
    audioContext ??= new AudioContext();
    return audioContext;
  };

  const playTone = (
    context: AudioContext,
    frequency: number,
    start: number,
    duration: number,
    type: OscillatorType,
    volume: number,
  ) => {
    const oscillator = context.createOscillator();
    const gain = context.createGain();

    oscillator.type = type;
    oscillator.frequency.setValueAtTime(frequency, start);
    gain.gain.setValueAtTime(0.0001, start);
    gain.gain.exponentialRampToValueAtTime(volume, start + 0.02);
    gain.gain.exponentialRampToValueAtTime(0.0001, start + duration);

    oscillator.connect(gain);
    gain.connect(context.destination);
    oscillator.start(start);
    oscillator.stop(start + duration + 0.03);
  };

  const playTimerSound = (kind: "start" | "cue" | "done") => {
    const context = getAudioContext();
    const now = context.currentTime;

    if (kind === "start") {
      playTone(context, 523.25, now, 1.1, "square", 0.6);
      return;
    }

    if (kind === "cue") {
      playTone(context, 659.25, now, 0.6, "sine", 0.8);
      playTone(context, 880, now + 0.6, 0.7, "sine", 0.75);
      return;
    }

    playTone(context, 392, now, 0.3, "triangle", 0.7);
    playTone(context, 523.25, now + 0.32, 0.3, "triangle", 0.7);
    playTone(context, 784, now + 0.64, 0.5, "triangle", 0.78);
  };

  const initializeTimers = () => {
    document
      .querySelectorAll<HTMLElement>("[data-kickboxing-timer]")
      .forEach(timer => {
        if (timer.dataset.timerReady === "true") return;
        timer.dataset.timerReady = "true";

        const duration = Number(timer.dataset.duration);
        const readout = timer.querySelector<HTMLElement>(
          ".kickboxing-timer__readout",
        );
        const toggle = timer.querySelector<HTMLButtonElement>(
          "[data-timer-toggle]",
        );
        const reset =
          timer.querySelector<HTMLButtonElement>("[data-timer-reset]");

        if (!duration || !readout || !toggle || !reset) return;

        const beepMarks = (timer.dataset.beeps ?? "")
          .split(",")
          .map(Number)
          .filter(value => Number.isFinite(value) && value > 0);
        const firedBeeps = new Set<number>();

        let running = false;
        let remaining = duration;
        let startedAt = 0;
        let startedWith = duration;
        let animationFrame = 0;

        const paint = () => {
          readout.textContent = formatTime(remaining);
          timer.style.setProperty(
            "--timer-progress",
            String(1 - remaining / duration),
          );
        };

        const stopFrame = () => {
          if (animationFrame) cancelAnimationFrame(animationFrame);
          animationFrame = 0;
        };

        const pause = () => {
          running = false;
          stopFrame();
          toggle.textContent = "Resume";
          timer.dataset.timerState = "paused";
        };

        const finish = () => {
          remaining = 0;
          running = false;
          stopFrame();
          paint();
          playTimerSound("done");
          toggle.textContent = "Start";
          timer.dataset.timerState = "done";
        };

        const tick = () => {
          const elapsed = (performance.now() - startedAt) / 1000;
          remaining = Math.max(0, startedWith - elapsed);

          if (remaining > 0) {
            for (const mark of beepMarks) {
              if (!firedBeeps.has(mark) && remaining <= mark) {
                firedBeeps.add(mark);
                playTimerSound("cue");
              }
            }
          }

          paint();

          if (remaining <= 0) {
            finish();
            return;
          }

          animationFrame = requestAnimationFrame(tick);
        };

        const start = async () => {
          const context = getAudioContext();
          if (context.state === "suspended") await context.resume();

          if (remaining <= 0) {
            remaining = duration;
            firedBeeps.clear();
          }

          running = true;
          startedAt = performance.now();
          startedWith = remaining;
          playTimerSound("start");
          toggle.textContent = "Pause";
          timer.dataset.timerState = "running";
          tick();
        };

        toggle.addEventListener("click", () => {
          if (running) {
            pause();
            return;
          }

          void start();
        });

        reset.addEventListener("click", () => {
          running = false;
          stopFrame();
          remaining = duration;
          firedBeeps.clear();
          toggle.textContent = "Start";
          timer.dataset.timerState = "idle";
          paint();
        });

        paint();
      });
  };

  initializeTimers();
  document.addEventListener("astro:page-load", initializeTimers);
</script>

<style>
  .kickboxing-block {
    /* per-kind accent — defaults to the site terracotta */
    --kb: var(--accent);
    --kb-dark: var(--accent-dark);
    --kb-tint: color-mix(in srgb, var(--kb) 9%, var(--white));
    --kb-line: color-mix(in srgb, var(--kb) 22%, transparent);

    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--kb-line);
    border-radius: var(--border-radius-medium);
    background: var(--white);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 14px 30px -22px rgba(122, 46, 31, 0.55);
  }

  /* accent spine down the left edge */
  .kickboxing-block::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: var(--kb);
  }

  .kickboxing-block--warm-up {
    --kb: #d97706;
    --kb-dark: #92400e;
  }

  .kickboxing-block--stretch {
    --kb: #2f8f83;
    --kb-dark: #165951;
  }

  .kickboxing-block--technique {
    --kb: #b85741;
    --kb-dark: #7a2e1f;
  }

  .kickboxing-block--drill {
    --kb: #3c6f9f;
    --kb-dark: #21486b;
  }

  .kickboxing-block--cardio {
    --kb: #c2410c;
    --kb-dark: #7c2d12;
  }

  .kickboxing-block--cool-down {
    --kb: #6b8e31;
    --kb-dark: #3d5819;
  }

  .kickboxing-block__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem 1rem;
    padding: 0.8rem 1rem 0.8rem 1.35rem;
    background: var(--kb-tint);
    border-bottom: 1px solid var(--kb-line);
  }

  .kickboxing-block__label-wrap {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.6rem;
  }

  .kickboxing-block__mark {
    width: 1.4rem;
    height: 3px;
    flex: 0 0 auto;
    border-radius: 2px;
    background: var(--kb);
  }

  .kickboxing-block__label {
    margin: 0;
    color: var(--kb-dark);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.1;
  }

  .kickboxing-block__body {
    padding: 0.85rem 1.15rem 1rem 1.35rem;
    color: var(--text-color);
    font-family: var(--font-serif);
  }

  .kickboxing-block__body :global(p) {
    margin: 0;
    text-align: left;
    line-height: 1.55;
  }

  .kickboxing-block__body :global(p + p) {
    margin-top: 0.5rem;
  }

  .kickboxing-block__body :global(ul),
  .kickboxing-block__body :global(ol) {
    margin: 0.35rem 0 0;
    padding-left: 1.2rem;
  }

  /* Timer — compact stopwatch pill */
  .kickboxing-timer {
    display: grid;
    width: min(20rem, 100%);
    max-width: 100%;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    padding: 0.38rem 0.42rem 0.38rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--kb) 30%, transparent);
    border-radius: 999px;
    background: var(--white);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.05);
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .kickboxing-timer__readout {
    min-width: 3rem;
    color: var(--kb-dark);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }

  .kickboxing-timer__bar {
    height: 0.4rem;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--kb) 16%, var(--white));
  }

  .kickboxing-timer__bar span {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleX(var(--timer-progress));
    transform-origin: left center;
    border-radius: inherit;
    background: var(--kb);
    transition: transform 0.12s linear;
  }

  .kickboxing-timer__controls {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .kickboxing-timer__button {
    min-width: 2.9rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
    transition:
      transform 0.12s ease,
      background 0.2s ease,
      filter 0.2s ease;
  }

  .kickboxing-timer__button--start {
    background: var(--kb);
    border-color: var(--kb);
    color: var(--white);
  }

  .kickboxing-timer__button--reset {
    background: transparent;
    border-color: color-mix(in srgb, var(--kb) 35%, transparent);
    color: var(--kb-dark);
  }

  .kickboxing-timer__button:hover {
    transform: translateY(-1px);
    filter: saturate(1.1);
  }

  .kickboxing-timer__button--reset:hover {
    background: color-mix(in srgb, var(--kb) 12%, var(--white));
  }

  .kickboxing-timer__button:active {
    transform: translateY(0) scale(0.97);
  }

  .kickboxing-timer__button:focus-visible {
    outline: 2px solid var(--kb);
    outline-offset: 2px;
  }

  .kickboxing-timer[data-timer-state="running"] {
    border-color: var(--kb);
    background: color-mix(in srgb, var(--kb) 7%, var(--white));
  }

  .kickboxing-timer[data-timer-state="running"] .kickboxing-timer__readout {
    color: var(--kb);
    animation: kickboxing-pulse 1s ease-in-out infinite;
  }

  .kickboxing-timer[data-timer-state="done"] {
    border-color: var(--kb-dark);
  }

  .kickboxing-timer[data-timer-state="done"] .kickboxing-timer__readout {
    color: var(--kb-dark);
  }

  @keyframes kickboxing-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kickboxing-timer[data-timer-state="running"] .kickboxing-timer__readout {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .kickboxing-block__header {
      align-items: flex-start;
      flex-direction: column;
    }

    .kickboxing-timer {
      width: min(20rem, 100%);
      align-self: center;
      gap: 0.45rem;
      padding-left: 0.55rem;
    }

    .kickboxing-timer__readout {
      min-width: 2.6rem;
      font-size: 0.9rem;
    }

    .kickboxing-timer__button {
      min-width: 0;
      padding: 0.4rem 0.5rem;
    }
  }

  @media print {
    .kickboxing-block {
      box-shadow: none;
      break-inside: avoid;
    }

    .kickboxing-timer__controls {
      display: none;
    }
  }
</style>
